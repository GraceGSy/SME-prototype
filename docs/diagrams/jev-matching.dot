digraph JevPipelineB {
  graph [rankdir=TB, newrank=true, bgcolor="white", pad=0.3, nodesep=0.28,
    ranksep=0.32, fontname="Times New Roman,", fontsize=12, labelloc=t,
    label="B. One directional match: Jev selection, fixed-target evidence, and recovery\nUsed by every initial, singleton-recovery, and older-paragraph pass in A. Each box has one responsibility."];
  node [shape=box, style=filled, fillcolor="#e7f4e8", color="#6b8b73",
    fontname="Times New Roman,", fontsize=12, fontcolor=black, margin="0.14,0.10"];
  edge [fontname="Times New Roman,", fontsize=12, color=black, arrowsize=0.65];

  legend [shape=plain, style="", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="5" CELLPADDING="6">
    <TR><TD BGCOLOR="#f1eafb">JEV: match selection</TD><TD BGCOLOR="#fff0d8">LLM: questions / quoted evidence</TD>
    <TD BGCOLOR="#e7f4e8">PYTHON: deterministic steps</TD></TR>
    <TR><TD COLSPAN="3">Read B1, B2, then B3. B2 is recursive; only its final outer result enters B3.</TD></TR>
  </TABLE>>];

  subgraph cluster_dispatch {
    label="B1. Request, complete-cache lookup, and failure recovery";
    request [label="PYTHON: receive one directional request from A\nOne focus + eligible candidates + full source evidence\nShared role policy/examples; unique opaque candidate handles\nNo votes from the opposite direction"];
    empty [shape=diamond, label="PYTHON: empty pool?"];
    empty_result [label="PYTHON: return null without any provider call\nThe runner normally skips empty pools before this boundary"];
    complete_cache [shape=diamond, label="PYTHON: complete judgment\ncached and not forced?"];
    reuse [label="PYTHON: validate and reuse the complete judgment\nCheck allowed target and source-bound evidence\nRequire evidence target to equal its recorded Jev choice\nReturn to A; no Jev or generative call"];
    select [shape=ellipse, label="PYTHON: invoke selector B2\nUse its final outer distribution in B3"];
    failure_note [shape=plain, style="", label="Any invalid cache, unrelated contract error, exhausted repair,\nnon-size HTTP/network error, impossible size, or exceeded guard stops the attempt."];
    fail [label="PYTHON: record failure in the attempted revision\nRetain raw responses, valid caches, and last completed revision\nNo silent repair, truncation, or generative-selector fallback"];
    retry [label="PYTHON: retry RUN after operator inspection\nVerify unchanged frozen inputs and policy\nCreate a new revision; replay stages using valid caches\nChanged policy/source requires a new run\nA killed process may not have written failure.json"];
    limits [shape=plain, style="", label="Defaults: Jev 1.14.0; provider's 32 MiB body limit;\n500 Jev calls and 2,000,000 input tokens per process.\nService checks token context; no bytes-to-tokens estimate.\nNo long-context opt-in or confidence threshold.\nTimeouts may have billed; process budgets reset on retry."];

    request -> empty;
    empty -> empty_result [label="yes"];
    empty -> complete_cache [label="no"];
    complete_cache -> reuse [label="yes"];
    complete_cache -> select [label="no"];
    select -> failure_note [style=invis];
    failure_note -> fail [style=invis];
    fail -> retry [label="after inspection"];
    retry -> limits [style=invis];
  }

  subgraph cluster_selector {
    label="B2. Cached Jev selector (recursive)";
    build [label="PYTHON: build Choice request for this candidate pool\nstate = focus, full candidate evidence, shared source-text table\ncriteria = candidate handles + NO_MATCH; pin model version"];
    fits [shape=diamond, label="PYTHON: 1-254 candidates\nand body at most 32 MiB?"];
    single [shape=diamond, label="PYTHON: only\none candidate?"];
    too_large [label="PYTHON: stop; focus + candidate cannot fit\nNever truncate source evidence"];
    split [label="PYTHON: split the ordered pool into two halves\nInvoke B2 recursively for each half with the same focus\nDo not generate explanations for intermediate choices"];
    shortlist [label="PYTHON: retain up to 5 candidate IDs per half\nRank only within each half's final returned distribution\nExclude NO_MATCH from these five; keep original evidence\nNever compare probabilities across independent halves"];
    shrinks [shape=diamond, label="PYTHON: shortlist\nsmaller than input?"];
    rerank [label="PYTHON: rebuild request for the combined shortlist\nInclude NO_MATCH again; re-enter B2's size/cache checks\nIts final Choice, not a half-pool winner, selects the target"];
    cannot_shrink [label="PYTHON: stop; reranking cannot fit without evidence loss"];
    selection_cache [shape=diamond, label="PYTHON: exact request\nin selection cache?"];
    cached_choice [label="PYTHON: revalidate cached request and response\nSame model, options, distribution and usage contract\nNo paid call; record cache hit"];
    guard [label="PYTHON: check Jev call / cumulative input-token guards\nLoad credentials; submit one request; no automatic HTTP retry\nNever store the Authorization header"];
    api [fillcolor="#f1eafb", color="#7054a0", peripheries=2,
      label="JEV: evaluate one Choice named match\nPOST https://api.typesafe.ai/v1/systemone\nReturn choice, probabilities, confidence, model and token usage"];
    size_error [shape=diamond, label="PYTHON: HTTP 400\nmax_tokens_exceeded\nor HTTP 413?"];
    contract [label="PYTHON: retain raw response before accepting it\nValidate model, exact options, finite normalized probabilities,\nhighest-probability choice, confidence range and usage\nCheck post-response token guard; cache a valid selection"];
    distribution [shape=ellipse, label="PYTHON: return final distribution + recorded trace\nTo recursive caller, or to B3 for the outer request"];
    caveat [shape=plain, style="", label="Recursive half-pool calls use this same Jev API step.\nShortlisting can discard a globally preferable candidate.\nA valid probability distribution does not establish match quality."];

    build -> fits;
    fits -> single [label="no"];
    single -> too_large [label="yes"];
    single -> split [label="no"];
    split -> shortlist [label="after both recursive returns"];
    shortlist -> shrinks;
    shrinks -> cannot_shrink [label="no"];
    shrinks -> rerank [label="yes"];
    rerank -> build [label="rerank", style=dashed, constraint=false];
    fits -> selection_cache [label="yes"];
    selection_cache -> cached_choice [label="hit; not forced"];
    selection_cache -> guard [label="miss / forced"];
    guard -> api -> size_error;
    size_error -> single [label="yes: retain error; split", style=dashed, constraint=false];
    size_error -> contract [label="success; other errors stop"];
    contract -> distribution;
    cached_choice -> distribution;
    distribution -> caveat [style=invis];
  }

  subgraph cluster_evidence {
    label="B3. Fixed-target evidence and return to A";
    target [label="PYTHON: read final outer choice from B2\nRetain all choice distributions, confidence and usage\nDo not apply a new confidence threshold"];
    none [shape=diamond, label="PYTHON: selected\nNO_MATCH?"];
    abstain [label="PYTHON: normalize abstention\ntarget_id = null; deterministic basis; empty evidence\nNo generative explanation call"];
    bind [label="PYTHON: prepare fixed-target evidence request\nSupply only focus + Jev-selected candidate\nBind schema target_id to that candidate; forbid null\nKeep the Jev choice cached independently of evidence"];
    evidence [fillcolor="#fff0d8", color="#b68a49",
      label="LLM: run the existing match-role Skill\nGenerate a basis and source quotations for the fixed target\nDo not replace, reject, or reselect the target"];
    check [label="PYTHON: validate returned target and evidence\nCheck source attribution, quote length, and allowed structure\nRetain rejected responses for diagnosis"];
    valid [shape=diamond, label="PYTHON: valid\nevidence?"];
    repairable [shape=diamond, label="PYTHON: quote error\nand fewer than\n2 repairs used?"];
    feedback [label="PYTHON: add quote-repair feedback\nReuse the same source evidence and cached Jev selection\nRequest a complete corrected explanation"];
    stop [label="PYTHON: stop this attempt\nUnrelated contract errors or exhausted quote repairs\nFollow failure recovery in B1"];
    result [label="PYTHON: save complete judgment and return to A\nExisting target_id / basis / evidence contract + Jev trace\nA completes all directional judgments before reconciliation\nKeep evidence even for nonreciprocal, rejected choices"];
    note [shape=plain, style="", label="Quote checks establish source attribution, not semantic correctness.\nThe explanation model cannot veto Jev's selection.\nAn evidence-generation failure does not discard a saved Jev choice."];

    target -> none;
    none -> abstain [label="yes"];
    none -> bind [label="no"];
    bind -> evidence -> check -> valid;
    valid -> result [label="yes"];
    valid -> repairable [label="no"];
    repairable -> feedback [label="yes"];
    feedback -> evidence [label="evidence retry only", style=dashed, constraint=false];
    repairable -> stop [label="no"];
    abstain -> result;
    result -> note [style=invis];
  }

  { rank=same; request; build; target; }
  request -> build -> target [style=invis];
  legend -> request [style=invis];
  legend -> build [style=invis];
  legend -> target [style=invis];
}
