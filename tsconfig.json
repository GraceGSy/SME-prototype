{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["node"],
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "pipeline/viewer/**/*.ts",
    "pipeline/manual_matcher/**/*.ts",
    "tests/viewer/**/*.ts",
    "tests/manual-matcher.test.ts",
    "playwright.config.ts"
  ]
}
