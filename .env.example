# Copy to .env (in this folder or any parent folder) and fill in the keys you need.
# .env is ignored by git. Values already set in the environment take precedence.

# Jev matching (TypeSafe). The default `--jev` run needs this key AND ANTHROPIC_API_KEY.
TYPESAFE_API_KEY=

# Claude: role-statement preparation (pipeline.prepare_roles) and Claude-backed stages.
ANTHROPIC_API_KEY=

# Optional: only for configs that set the model provider to OpenAI.
OPENAI_API_KEY=
